# ============================================================
# ICT SalesLocker — Environment Variables
# Copy this file to .env.local and fill in your values
# NEVER commit .env.local to git
# ============================================================

# Supabase — get these from your project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Supabase Service Role Key (server-side only — used for CSV imports)
# Get from Settings > API > service_role key — keep secret
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Xero — get these from developer.xero.com/myapps > your app > Configuration
XERO_CLIENT_ID=your-xero-client-id-here
XERO_CLIENT_SECRET=your-xero-client-secret-here
XERO_REDIRECT_URI=http://localhost:3000/api/xero/callback

# Bullhorn — register an OAuth app at your Bullhorn instance's developer
# portal (Bullhorn Marketplace > "App to Register" / Universal Login).
# BULLHORN_AUTH_URL / BULLHORN_LOGIN_URL only need setting if this
# account uses a non-default data centre host.
BULLHORN_CLIENT_ID=your-bullhorn-client-id-here
BULLHORN_CLIENT_SECRET=your-bullhorn-client-secret-here
BULLHORN_REDIRECT_URI=http://localhost:3000/api/bullhorn/callback
# BULLHORN_AUTH_URL=https://auth.bullhornstaffing.com/oauth
# BULLHORN_LOGIN_URL=https://rest.bullhornstaffing.com/rest-services/login

# Vercel Cron — shared secret checked on GET requests to the /sync
# routes (Autotask, Xero, Bullhorn) so only Vercel's scheduler can
# trigger them without a logged-in session
CRON_SECRET=a-long-random-string-here
